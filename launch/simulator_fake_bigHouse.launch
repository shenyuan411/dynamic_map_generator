<launch>
	<arg name="init_x" />
	<arg name="init_y" />
	<arg name="init_z" />
	<arg name="map_size_x" default="7"/>
	<arg name="map_size_y" default="8"/><!-- 减去2再除以2才是正负的速度反向的位置 -->
	<arg name="map_size_z" default="3"/>
	<arg name="c_num" />
	<arg name="p_num" />
	<arg name="min_dist" />
	<arg name="odometry_topic" />
	<arg name="odom_pose_topic" />
	<arg name="drone_id" />
	<arg name="map_mode1" default="1" /> <!-- 0表示都用，1表示y静止，2是x静止，3是直接静止-->
	<arg name="given_vel1x" default="1.2"/>  <!-- 单位 标准的m/s  -->
	<arg name="given_vel1y" default="1.2"/>  
	<arg name="map_mode2" default="2" /> <!-- 0表示都用，1表示y静止，2是x静止，3是直接静止-->
	<arg name="given_vel2x" default="0.6"/> 
	<arg name="given_vel2y" default="0.6"/>  
	<arg name="map_mode3" default="1" /> <!-- 0表示都用，1表示y静止，2是x静止，3是直接静止-->
	<arg name="given_vel3x" default="1.0"/>
	<arg name="given_vel3y" default="1.0"/>  
	<arg name="map_mode4" default="2" /> <!-- 0表示都用，1表示y静止，2是x静止，3是直接静止-->
	<arg name="given_vel4x" default="1.2"/>  
	<arg name="given_vel4y" default="1.2"/>  
	<arg name="map_mode5" default="1" />
	<arg name="given_vel5x" default="0.6"/>  
	<arg name="given_vel5y" default="0.4"/> 

	<!-- map -->
	<!-- <include file="$(find dyn_map_generator)/launch/read_pcd.launch" /> -->

	<!-- <node pkg ="dyn_map_generator" name ="map_generator" type ="dynamic_walker" output = "screen" launch-prefix="gdb -ex run - -args"> -->
	<node pkg ="dyn_map_generator" name ="map_generator" type ="dynamic_walker_release" output = "screen">
		<remap from="~global_cloud" to="/map_generator/global_cloud" />
		<remap from="~global_cylinder_state" to="/ground_truth_state" />
		<param name="map/x_size" value="$(arg map_size_x)" />
		<param name="map/y_size" value="$(arg map_size_y)" />
		<param name="map/z_size" value="$(arg map_size_z)" />
		<param name="map/resolution" value="0.1"/>
		<param name="map/frame_id" value="world" />
		<param name="map/test" value="false" />

		<param name="ObstacleShape/seed" value="-1"/>
		<!-- 改变障碍物体积 -->
		<param name="ObstacleShape/lower_rad" value="0.5"/>
		<param name="ObstacleShape/upper_rad" value="1.0"/>
		<param name="ObstacleShape/lower_hei" value="0.0"/>
		<param name="ObstacleShape/upper_hei" value="2.0"/>
		<param name="ObstacleShape/upper_vel" value="0.6" />
		<param name="ObstacleShape/set_cylinder" value="true"/>

		<param name="map/circle_num" value="0"/>
		<param name="ObstacleShape/radius_l" value="0.7"/>
		<param name="ObstacleShape/radius_h" value="2.5"/>
		<param name="ObstacleShape/z_l" value="0.8"/>
		<param name="ObstacleShape/z_h" value="2.0"/>
		<param name="ObstacleShape/dr" value="0.0"/>
		<param name="ObstacleShape/theta" value="0.2"/>

		<param name="sensing/radius" value="10.0"/>
		<param name="sensing/rate" value="20.0"/>
		<param name="sensing/noiseLevel" value="0.05"/>
		<!-- <param name="load_pcd_file" value="false"/> -->
		<param name="load_pcd_file" value="true"/>
		<param name="file_path" value="/home/nros/bigHouse2.pcd"/>
		<param name="dyn_obj_cld_pub" value="false"/>
		<!-- <param name="dyn_obj_cld_pub" value="true"/> -->
		<param name="map/obs_num" value="5"/>

		<param name="obs1x" value="-2.0"/>
		<param name="obs1y" value="0.0"/>
		<param name="obs1w" value="0.5"/> <!-- 圆柱的宽度 -->
		<param name="obs1h" value="1.8"/>
		<param name="mode1" value="$(arg map_mode1)" />
		<param name="given_vel1x" value="$(arg given_vel1x)"/>
		<param name="given_vel1y" value="$(arg given_vel1y)"/>
		<param name="obs1x_l" value="-11.0"/>
		<param name="obs1x_h" value="-1.0"/>
		<param name="obs1y_l" value="-1.0"/>
		<param name="obs1y_h" value="1.0"/>

		<param name="obs2x" value="-1.0"/>
		<param name="obs2y" value="-5.0"/>
		<param name="obs2w" value="1.5"/> <!-- 圆柱的宽度 -->
		<param name="obs2h" value="0.5"/>
		<param name="mode2" value="$(arg map_mode2)" />
		<param name="given_vel2x" value="$(arg given_vel2x)"/>
		<param name="given_vel2y" value="$(arg given_vel2y)"/>
		<param name="obs2x_l" value="-1.0"/>
		<param name="obs2x_h" value="1.0"/>
		<param name="obs2y_l" value="-7.0"/>
		<param name="obs2y_h" value="-4.0"/>

		<param name="obs3x" value="0.0"/>
		<param name="obs3y" value="4.0"/>
		<param name="obs3w" value="1.0"/> <!-- 圆柱的宽度 -->
		<param name="obs3h" value="1.2"/>
		<param name="mode3" value="$(arg map_mode3)" />
		<param name="given_vel3x" value="$(arg given_vel3x)"/>
		<param name="given_vel3y" value="$(arg given_vel3y)"/>
		<param name="obs3x_l" value="-1.5"/>
		<param name="obs3x_h" value="5.5"/>
		<param name="obs3y_l" value="3.0"/>
		<param name="obs3y_h" value="5.0"/>

		<param name="obs4x" value="4.0"/>
		<param name="obs4y" value="7.0"/>
		<param name="obs4w" value="0.5"/> <!-- 圆柱的宽度 -->
		<param name="obs4h" value="2.3"/>
		<param name="mode4" value="$(arg map_mode4)" />
		<param name="given_vel4x" value="$(arg given_vel4x)"/>
		<param name="given_vel4y" value="$(arg given_vel4y)"/>
		<param name="obs4x_l" value="7.0"/>
		<param name="obs4x_h" value="9.0"/>
		<param name="obs4y_l" value="2.0"/>
		<param name="obs4y_h" value="8.0"/>

		<param name="obs5x" value="-11.0"/>
		<param name="obs5y" value="-1.0"/>
		<param name="obs5w" value="0.7"/> <!-- 圆柱的宽度 -->
		<param name="obs5h" value="0.7"/>
		<param name="mode5" value="$(arg map_mode5)" />
		<param name="given_vel5x" value="$(arg given_vel5x)"/>
		<param name="given_vel5y" value="$(arg given_vel5y)"/>
		<param name="obs5x_l" value="-12.0"/>
		<param name="obs5x_h" value="-0.0"/>
		<param name="obs5y_l" value="-2.0"/>
		<param name="obs5y_h" value="1.0"/>

		
		<param name="map/wall_num" value="0"/>
		<param name="map/box_num" value="0"/>

	</node>
	
	<!-- <node pkg="tf" type="static_transform_publisher" name="world_map_broadcaster" args="0 0 0 0 0 0 world map 100" /> -->
</launch>


